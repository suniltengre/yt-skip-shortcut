{
  "manifest_version": 3,
  "name": "YT Skip Shortcut",
  "version": "2.1.2",
  "description": "Skip YouTube ads automatically or with your own keyboard shortcut.",
  "permissions": ["storage", "debugger"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "YT Skip Shortcut",
              "default_icon": { "16": "icon16.png", "32": "icon32.png" } },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
